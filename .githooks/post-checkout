#!/bin/sh
# worktree に、メインリポジトリの .claude への symlink を張る。
# .claude は gitignore されていて worktree には複製されないが、その中の
# skills / rules は worktree で作業するときにも要る。
#
# 相対パスで張るのは、ツリーごと移動したときに壊れないようにするため。
# git worktree repair は git 自身のパスしか直さない。

# 第3引数はブランチの checkout なら 1、ファイル単体の checkout なら 0。
# worktree の作成は前者なので、後者では何もしない。
[ "$3" = "1" ] || exit 0

git_dir=$(git rev-parse --git-dir)
common_dir=$(git rev-parse --git-common-dir)
[ "$git_dir" = "$common_dir" ] && exit 0

main_root=$(cd "$common_dir/.." && pwd)
[ -d "$main_root/.claude" ] || exit 0

worktree_root=$(pwd)
link="$worktree_root/.claude"
{ [ -e "$link" ] || [ -L "$link" ]; } && exit 0

# 起点ディレクトリから見た対象の相対パス。
target="$main_root/.claude"
base=$worktree_root
up=""
while [ "$base" != "/" ] && [ "${target#"$base"/}" = "$target" ]; do
	base=$(dirname "$base")
	up="../$up"
done
if [ "$base" = "/" ]; then
	rest=${target#/}
else
	rest=${target#"$base"/}
fi

ln -s "$up$rest" "$link"
